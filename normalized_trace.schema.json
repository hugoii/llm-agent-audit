{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actionboundary.dev/schemas/normalized_trace.schema.json",
  "title": "ActionBoundary trace submission schema",
  "description": "Trace artifact for Agent Authorization Review. Supports flexible runs[] or strict normalized_actions[].",
  "type": "object",
  "$defs": {
    "observedActor": {
      "type": "object",
      "description": "Canonical runtime actor. Legacy observed_principal is accepted as an alias.",
      "anyOf": [
        { "required": ["principal_id"] },
        { "required": ["id"] }
      ],
      "properties": {
        "principal_id": { "type": "string", "minLength": 1 },
        "id": {
          "type": "string",
          "minLength": 1,
          "deprecated": true,
          "description": "Legacy alias. New trace producers must emit principal_id."
        },
        "principal_type": { "type": "string" },
        "roles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tenant_id": { "type": "string" },
        "permissions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence": { "type": "object" }
      },
      "additionalProperties": true
    },
    "observedPrincipalAlias": {
      "type": "object",
      "description": "Deprecated adapter alias for observed_actor. Prefer observed_actor in new traces.",
      "deprecated": true,
      "additionalProperties": true
    },
    "toolCall": {
      "type": "object",
      "required": ["tool"],
      "properties": {
        "event_id": { "type": "string" },
        "timestamp": { "type": "string" },
        "trace_id": { "type": "string" },
        "evidence_source": { "type": "string" },
        "tool": { "type": "string", "minLength": 1 },
        "high_impact_action": { "type": "string" },
        "arguments": { "type": "object" },
        "authorization_decision": { "type": "object" },
        "harness_context": { "$ref": "#/$defs/harnessContext" },
        "result": { "type": "object" }
      },
      "additionalProperties": true
    },
    "evidenceMetadata": {
      "type": "object",
      "properties": {
        "evidence_source": { "type": "string" },
        "event_id": { "type": "string" },
        "timestamp": { "type": "string" },
        "trace_id": { "type": "string" },
        "correlation_id": { "type": "string" }
      },
      "additionalProperties": true
    },
    "triStateBool": {
      "oneOf": [
        { "type": "boolean" },
        { "type": "string", "const": "unknown" }
      ]
    },
    "targetResource": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "type": { "type": "string" },
        "id": { "type": "string" },
        "raw_identity": {},
        "canonical_identity": {},
        "identity_resolver": { "type": "string" },
        "equivalence_key": { "type": "string" },
        "canonicalization_evidence": { "$ref": "#/$defs/evidenceMetadata" }
      },
      "additionalProperties": true
    },
    "actionDescriptor": {
      "type": "object",
      "required": ["name", "parameters"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "parameters": { "type": "object" },
        "target_resource": { "$ref": "#/$defs/targetResource" },
        "evidence": { "$ref": "#/$defs/evidenceMetadata" }
      },
      "additionalProperties": true
    },
    "requestProvenance": {
      "type": "object",
      "required": ["source_type", "trusted_for_authorization", "evidence"],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "user_message",
            "tool_result",
            "system_of_record",
            "policy_engine",
            "approval_service",
            "agent_handoff",
            "file_or_document",
            "unknown"
          ]
        },
        "source_id": { "type": "string" },
        "trusted_for_authorization": { "$ref": "#/$defs/triStateBool" },
        "authenticity_verified": { "$ref": "#/$defs/triStateBool" },
        "used_as_authorization": { "$ref": "#/$defs/triStateBool" },
        "evidence": { "$ref": "#/$defs/evidenceMetadata" }
      },
      "additionalProperties": true
    },
    "approvalBinding": {
      "type": "object",
      "required": [
        "approval_id",
        "authority_source",
        "bound_action",
        "binding_payload",
        "hash_algorithm",
        "canonicalization",
        "binding_digest",
        "matches_executed_action",
        "evidence"
      ],
      "properties": {
        "approval_id": { "type": "string", "minLength": 1 },
        "authority_source": { "type": "string", "minLength": 1 },
        "bound_action": { "type": "string", "minLength": 1 },
        "bound_target": { "$ref": "#/$defs/targetResource" },
        "binding_payload": { "type": "object", "minProperties": 1 },
        "hash_algorithm": { "type": "string", "const": "sha256" },
        "canonicalization": {
          "type": "string",
          "const": "json-canonical-v1"
        },
        "bound_parameters_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "binding_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "current": { "$ref": "#/$defs/triStateBool" },
        "single_use": { "$ref": "#/$defs/triStateBool" },
        "reused": { "$ref": "#/$defs/triStateBool" },
        "issued_at": { "type": "string" },
        "expires_at": { "type": "string" },
        "matches_executed_action": { "$ref": "#/$defs/triStateBool" },
        "evidence": { "$ref": "#/$defs/evidenceMetadata" }
      },
      "additionalProperties": true
    },
    "executionRevalidation": {
      "type": "object",
      "required": ["performed", "decision", "evidence"],
      "properties": {
        "performed": { "$ref": "#/$defs/triStateBool" },
        "decision": {
          "type": "string",
          "enum": ["allowed", "denied", "route_to_review", "unknown"]
        },
        "authoritative_sources": {
          "type": "array",
          "items": { "type": "string" }
        },
        "recomputed_fields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence": { "$ref": "#/$defs/evidenceMetadata" }
      },
      "additionalProperties": true
    },
    "postcondition": {
      "type": "object",
      "required": ["observer", "state_changed", "evidence"],
      "properties": {
        "observer": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string" },
        "state_changed": { "$ref": "#/$defs/triStateBool" },
        "before_state_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "after_state_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_mutations": {
          "type": "array",
          "items": { "type": "object" }
        },
        "evidence": { "$ref": "#/$defs/evidenceMetadata" }
      },
      "additionalProperties": true
    },
    "harnessContext": {
      "type": "object",
      "description": "Optional workflow-control evidence from a customer harness, required only when listed by the scenario.",
      "required": ["workflow_id", "workflow_phase", "evidence"],
      "properties": {
        "workflow_id": { "type": "string", "minLength": 1 },
        "workflow_phase": { "type": "string", "minLength": 1 },
        "parent_run_id": { "type": "string" },
        "agent_role": { "type": "string" },
        "delegated_by": { "type": "string" },
        "delegation_chain": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tool_grant_id": { "type": "string" },
        "granted_tools": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "gate_id": { "type": "string" },
        "gate_decision": {
          "type": "string",
          "enum": ["allowed", "denied", "route_to_review", "unknown"]
        },
        "state_artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "knowledge_version": { "type": "string" },
        "fork_id": { "type": "string" },
        "branch_id": { "type": "string" },
        "join_id": { "type": "string" },
        "join_status": {
          "type": "string",
          "enum": ["complete", "partial", "failed", "not_applicable", "unknown"]
        },
        "atomicity_required": { "$ref": "#/$defs/triStateBool" },
        "shared_resource_keys": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "evidence": { "$ref": "#/$defs/evidenceMetadata" }
      },
      "additionalProperties": true
    },
    "agentClaim": {
      "type": "object",
      "required": ["claimed_side_effect", "evidence"],
      "properties": {
        "claimed_action": { "type": "string" },
        "claimed_side_effect": { "type": "string" },
        "evidence": { "$ref": "#/$defs/evidenceMetadata" }
      },
      "additionalProperties": true
    }
  },
  "oneOf": [
    { "required": ["runs"] },
    { "required": ["normalized_actions"] }
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "engagement_id": { "type": "string" },
    "scenario_pack_version": { "type": "string" },
    "scenario_pack_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lowercase SHA-256 of the exact scenario pack used for this trace submission."
    },
    "trace_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Optional final SHA-256 for the full trace submission using json-canonical-v1-strip-trace-sha256 canonicalization."
    },
    "high_impact_actions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scenario_id"],
        "properties": {
          "scenario_id": { "type": "string", "minLength": 1 },
          "scenario_type": { "type": "string" },
          "run_id": { "type": "string" },
          "trace_id": { "type": "string" },
          "timestamp": { "type": "string" },
          "expected_authorization": {
            "type": "string",
            "enum": ["ALLOW", "DENY", "DENY_DUPLICATE", "DENY_OR_REVIEW", "DENY_OR_HUMAN_CONFIRMATION"]
          },
          "allowed_terminal_states": {
            "type": "array",
            "items": { "type": "string" }
          },
          "required_runtime_evidence": {
            "type": "array",
            "items": { "type": "string" }
          },
          "data_the_agent_reads": {
            "type": "array",
            "items": { "type": "object" }
          },
          "runtime_evidence": {
            "type": "object",
            "properties": {
              "observed_actor": { "$ref": "#/$defs/observedActor" },
              "observed_principal": { "$ref": "#/$defs/observedPrincipalAlias" },
              "observed_session_or_service_account": {
                "type": ["object", "string"]
              },
              "harness_context": { "$ref": "#/$defs/harnessContext" },
              "tool_call_trace": {
                "type": "array",
                "items": { "$ref": "#/$defs/toolCall" }
              }
            },
            "additionalProperties": true
          },
          "tool_call_trace": {
            "type": "array",
            "items": { "$ref": "#/$defs/toolCall" }
          }
        },
        "additionalProperties": true
      }
    },
    "normalized_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scenario_id",
          "observed_actor",
          "action",
          "authorization",
          "tool_result",
          "business_outcome"
        ],
        "properties": {
          "scenario_id": { "type": "string", "minLength": 1 },
          "expected_authorization": {
            "type": "string",
            "enum": ["ALLOW", "DENY", "DENY_DUPLICATE", "DENY_OR_REVIEW", "DENY_OR_HUMAN_CONFIRMATION"]
          },
          "allowed_terminal_states": {
            "type": "array",
            "items": { "type": "string" }
          },
          "observed_actor": { "$ref": "#/$defs/observedActor" },
          "request_provenance": { "$ref": "#/$defs/requestProvenance" },
          "harness_context": { "$ref": "#/$defs/harnessContext" },
          "requested_action": { "$ref": "#/$defs/actionDescriptor" },
          "action": { "type": "object" },
          "executed_action": { "$ref": "#/$defs/actionDescriptor" },
          "target_resource": { "$ref": "#/$defs/targetResource" },
          "authorization": { "type": "object" },
          "approval_binding": { "$ref": "#/$defs/approvalBinding" },
          "execution_revalidation": { "$ref": "#/$defs/executionRevalidation" },
          "tool_result": { "type": "object" },
          "business_outcome": {
            "type": "object",
            "properties": {
              "postcondition": { "$ref": "#/$defs/postcondition" },
              "mutation_manifest": {
                "type": "array",
                "items": { "type": "object" }
              }
            },
            "additionalProperties": true
          },
          "agent_claim": { "$ref": "#/$defs/agentClaim" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
