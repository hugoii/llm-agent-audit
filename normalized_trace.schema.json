{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actionboundary.dev/schemas/normalized_trace.schema.json",
  "title": "ActionBoundary trace submission schema",
  "description": "Trace artifact for Agent Authorization Review. Supports flexible runs[] or strict normalized_actions[].",
  "type": "object",
  "$defs": {
    "observedActor": {
      "type": "object",
      "description": "Canonical runtime actor. Legacy observed_principal is accepted as an alias.",
      "anyOf": [
        { "required": ["principal_id"] },
        { "required": ["id"] }
      ],
      "properties": {
        "principal_id": { "type": "string", "minLength": 1 },
        "id": {
          "type": "string",
          "minLength": 1,
          "deprecated": true,
          "description": "Legacy alias. New trace producers must emit principal_id."
        },
        "principal_type": { "type": "string" },
        "roles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tenant_id": { "type": "string" },
        "permissions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence": { "type": "object" }
      },
      "additionalProperties": true
    },
    "observedPrincipalAlias": {
      "type": "object",
      "description": "Deprecated adapter alias for observed_actor. Prefer observed_actor in new traces.",
      "deprecated": true,
      "additionalProperties": true
    },
    "toolCall": {
      "type": "object",
      "required": ["tool"],
      "properties": {
        "event_id": { "type": "string" },
        "timestamp": { "type": "string" },
        "trace_id": { "type": "string" },
        "evidence_source": { "type": "string" },
        "tool": { "type": "string", "minLength": 1 },
        "high_impact_action": { "type": "string" },
        "arguments": { "type": "object" },
        "authorization_decision": { "type": "object" },
        "result": { "type": "object" }
      },
      "additionalProperties": true
    }
  },
  "oneOf": [
    { "required": ["runs"] },
    { "required": ["normalized_actions"] }
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "engagement_id": { "type": "string" },
    "scenario_pack_version": { "type": "string" },
    "scenario_pack_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Lowercase SHA-256 of the exact scenario pack used for this trace submission."
    },
    "trace_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Optional final SHA-256 for the full trace submission using json-canonical-v1-strip-trace-sha256 canonicalization."
    },
    "high_impact_actions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scenario_id"],
        "properties": {
          "scenario_id": { "type": "string", "minLength": 1 },
          "scenario_type": { "type": "string" },
          "run_id": { "type": "string" },
          "trace_id": { "type": "string" },
          "timestamp": { "type": "string" },
          "expected_authorization": {
            "type": "string",
            "enum": ["ALLOW", "DENY", "DENY_DUPLICATE", "DENY_OR_REVIEW", "DENY_OR_HUMAN_CONFIRMATION"]
          },
          "allowed_terminal_states": {
            "type": "array",
            "items": { "type": "string" }
          },
          "required_runtime_evidence": {
            "type": "array",
            "items": { "type": "string" }
          },
          "data_the_agent_reads": {
            "type": "array",
            "items": { "type": "object" }
          },
          "runtime_evidence": {
            "type": "object",
            "properties": {
              "observed_actor": { "$ref": "#/$defs/observedActor" },
              "observed_principal": { "$ref": "#/$defs/observedPrincipalAlias" },
              "observed_session_or_service_account": {
                "type": ["object", "string"]
              },
              "tool_call_trace": {
                "type": "array",
                "items": { "$ref": "#/$defs/toolCall" }
              }
            },
            "additionalProperties": true
          },
          "tool_call_trace": {
            "type": "array",
            "items": { "$ref": "#/$defs/toolCall" }
          }
        },
        "additionalProperties": true
      }
    },
    "normalized_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scenario_id",
          "observed_actor",
          "action",
          "authorization",
          "tool_result",
          "business_outcome"
        ],
        "properties": {
          "scenario_id": { "type": "string", "minLength": 1 },
          "expected_authorization": {
            "type": "string",
            "enum": ["ALLOW", "DENY", "DENY_DUPLICATE", "DENY_OR_REVIEW", "DENY_OR_HUMAN_CONFIRMATION"]
          },
          "allowed_terminal_states": {
            "type": "array",
            "items": { "type": "string" }
          },
          "observed_actor": { "$ref": "#/$defs/observedActor" },
          "action": { "type": "object" },
          "authorization": { "type": "object" },
          "tool_result": { "type": "object" },
          "business_outcome": { "type": "object" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
