{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Strict normalized authorization evidence schema",
  "description": "Action-level runtime evidence for strict pilot verdicts.",
  "$comment": "Legacy-compatible normalized adapter schema. The canonical public trace contract is /normalized_trace.schema.json and canonical scored output is /verdict.schema.json.",
  "type": "object",
  "required": [
    "schema_version",
    "normalized_actions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "pilot-verdict-1.1"
    },
    "engagement_id": {
      "type": "string"
    },
    "scenario_pack_version": {
      "type": "string"
    },
    "scenario_pack_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trace_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Final full-submission trace hash, not a per-event or per-tool-call hash."
    },
    "normalized_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/normalized_action"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "evidence_metadata": {
      "type": "object",
      "required": [
        "evidence_source",
        "event_id",
        "timestamp"
      ],
      "properties": {
        "evidence_source": {
          "type": "string",
          "minLength": 1
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "minLength": 1
        },
        "trace_id": {
          "type": "string"
        },
        "correlation_id": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": [
            "trace_id"
          ]
        },
        {
          "required": [
            "correlation_id"
          ]
        }
      ],
      "additionalProperties": true
    },
    "target_resource": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "type": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "invoice_id": {
          "type": "string"
        },
        "vendor_id": {
          "type": "string"
        },
        "tenant_id": {
          "type": "string"
        },
        "legal_entity_id": {
          "type": "string"
        },
        "amount": {
          "type": [
            "number",
            "string"
          ]
        },
        "currency": {
          "type": "string"
        },
        "remit_to_account": {
          "type": "string"
        },
        "raw_identity": {},
        "canonical_identity": {},
        "identity_resolver": {
          "type": "string"
        },
        "equivalence_key": {
          "type": "string"
        },
        "canonicalization_evidence": {
          "$ref": "#/definitions/evidence_metadata"
        }
      },
      "additionalProperties": true
    },
    "tri_state_bool": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "harness_context": {
      "type": "object",
      "required": ["workflow_id", "workflow_phase", "evidence"],
      "properties": {
        "workflow_id": { "type": "string", "minLength": 1 },
        "workflow_phase": { "type": "string", "minLength": 1 },
        "parent_run_id": { "type": "string" },
        "agent_role": { "type": "string" },
        "delegated_by": { "type": "string" },
        "delegation_chain": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tool_grant_id": { "type": "string" },
        "granted_tools": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "gate_id": { "type": "string" },
        "gate_decision": {
          "type": "string",
          "enum": ["allowed", "denied", "route_to_review", "unknown"]
        },
        "state_artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "knowledge_version": { "type": "string" },
        "fork_id": { "type": "string" },
        "branch_id": { "type": "string" },
        "join_id": { "type": "string" },
        "join_status": {
          "type": "string",
          "enum": ["complete", "partial", "failed", "not_applicable", "unknown"]
        },
        "atomicity_required": { "$ref": "#/definitions/tri_state_bool" },
        "shared_resource_keys": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "evidence": { "$ref": "#/definitions/evidence_metadata" }
      },
      "additionalProperties": true
    },
    "normalized_action": {
      "type": "object",
      "required": [
        "scenario_id",
        "run_id",
        "action_id",
        "action_index",
        "business_action_key",
        "observed_actor",
        "target_resource",
        "authorization",
        "tool_result",
        "business_outcome",
        "evidence_completeness"
      ],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "action_index": {
          "type": [
            "integer",
            "null"
          ]
        },
        "business_action_key": {
          "type": "string",
          "minLength": 1,
          "description": "Use a real idempotency key, or 'none' for no-action traces."
        },
        "action": {
          "type": "object",
          "required": [
            "name",
            "high_impact_action",
            "normalized_parameters"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Use 'no_high_impact_action' for complete no-action traces."
            },
            "high_impact_action": {
              "type": "string",
              "minLength": 1,
              "description": "Use 'none' for a complete no-high-impact-action trace."
            },
            "normalized_parameters": {
              "type": "object"
            }
          },
          "additionalProperties": true
        },
        "request_provenance": {
          "type": "object",
          "required": [
            "source_type",
            "trusted_for_authorization",
            "evidence"
          ],
          "properties": {
            "source_type": { "type": "string" },
            "source_id": { "type": "string" },
            "trusted_for_authorization": { "$ref": "#/definitions/tri_state_bool" },
            "authenticity_verified": { "$ref": "#/definitions/tri_state_bool" },
            "used_as_authorization": { "$ref": "#/definitions/tri_state_bool" },
            "evidence": { "$ref": "#/definitions/evidence_metadata" }
          },
          "additionalProperties": true
        },
        "harness_context": {
          "$ref": "#/definitions/harness_context"
        },
        "requested_action": {
          "type": "object",
          "required": ["name", "parameters"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "parameters": { "type": "object" },
            "target_resource": { "$ref": "#/definitions/target_resource" },
            "evidence": { "$ref": "#/definitions/evidence_metadata" }
          },
          "additionalProperties": true
        },
        "executed_action": {
          "type": "object",
          "required": ["name", "parameters"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "parameters": { "type": "object" },
            "target_resource": { "$ref": "#/definitions/target_resource" },
            "evidence": { "$ref": "#/definitions/evidence_metadata" }
          },
          "additionalProperties": true
        },
        "observed_actor": {
          "type": "object",
          "required": [
            "principal_or_service_account",
            "evidence"
          ],
          "properties": {
            "principal_or_service_account": {},
            "evidence": {
              "$ref": "#/definitions/evidence_metadata"
            }
          },
          "additionalProperties": true
        },
        "target_resource": {
          "$ref": "#/definitions/target_resource"
        },
        "authorization": {
          "type": "object",
          "required": [
            "source",
            "current",
            "scope_match",
            "approval_covers_parameters",
            "decision",
            "evidence"
          ],
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "current": {
              "$ref": "#/definitions/tri_state_bool"
            },
            "scope_match": {
              "$ref": "#/definitions/tri_state_bool"
            },
            "approval_covers_parameters": {
              "$ref": "#/definitions/tri_state_bool"
            },
            "decision": {
              "type": "string",
              "enum": [
                "allowed",
                "denied",
                "route_to_review",
                "not_checked",
                "unknown"
              ]
            },
            "policy_version": {
              "type": "string"
            },
            "evidence": {
              "$ref": "#/definitions/evidence_metadata"
            }
          },
          "additionalProperties": true
        },
        "approval_binding": {
          "type": "object",
          "required": [
            "approval_id",
            "authority_source",
            "bound_action",
            "binding_payload",
            "hash_algorithm",
            "canonicalization",
            "binding_digest",
            "matches_executed_action",
            "evidence"
          ],
          "properties": {
            "approval_id": { "type": "string", "minLength": 1 },
            "authority_source": { "type": "string", "minLength": 1 },
            "bound_action": { "type": "string", "minLength": 1 },
            "bound_target": { "$ref": "#/definitions/target_resource" },
            "binding_payload": { "type": "object", "minProperties": 1 },
            "hash_algorithm": { "type": "string", "const": "sha256" },
            "canonicalization": {
              "type": "string",
              "const": "json-canonical-v1"
            },
            "bound_parameters_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "binding_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "current": { "$ref": "#/definitions/tri_state_bool" },
            "single_use": { "$ref": "#/definitions/tri_state_bool" },
            "reused": { "$ref": "#/definitions/tri_state_bool" },
            "matches_executed_action": { "$ref": "#/definitions/tri_state_bool" },
            "issued_at": { "type": "string" },
            "expires_at": { "type": "string" },
            "evidence": { "$ref": "#/definitions/evidence_metadata" }
          },
          "additionalProperties": true
        },
        "execution_revalidation": {
          "type": "object",
          "required": ["performed", "decision", "evidence"],
          "properties": {
            "performed": { "$ref": "#/definitions/tri_state_bool" },
            "decision": {
              "type": "string",
              "enum": ["allowed", "denied", "route_to_review", "unknown"]
            },
            "authoritative_sources": {
              "type": "array",
              "items": { "type": "string" }
            },
            "recomputed_fields": {
              "type": "array",
              "items": { "type": "string" }
            },
            "evidence": { "$ref": "#/definitions/evidence_metadata" }
          },
          "additionalProperties": true
        },
        "tool_result": {
          "type": "object",
          "required": [
            "attempted",
            "allowed_or_denied",
            "status",
            "evidence"
          ],
          "properties": {
            "attempted": {
              "type": "boolean"
            },
            "allowed_or_denied": {
              "type": "string",
              "enum": [
                "allowed",
                "denied",
                "not_called",
                "unknown"
              ]
            },
            "status": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "$ref": "#/definitions/evidence_metadata"
            }
          },
          "additionalProperties": true
        },
        "business_outcome": {
          "type": "object",
          "required": [
            "side_effect",
            "evidence"
          ],
          "properties": {
            "side_effect": {
              "type": "string",
              "enum": [
                "committed",
                "not_committed",
                "routed_to_review",
                "routed_to_reapproval",
                "duplicate_denied",
                "existing_result_returned",
                "unknown"
              ]
            },
            "ledger_or_record_id": {
              "type": "string"
            },
            "evidence": {
              "$ref": "#/definitions/evidence_metadata"
            },
            "observations": {
              "type": "object",
              "properties": {
                "duplicate_control_observed": {
                  "type": "boolean"
                },
                "idempotency_reused": {
                  "type": "boolean"
                },
                "source_of_truth_lookup_required": {
                  "type": "boolean"
                }
              },
              "additionalProperties": true
            },
            "postcondition": {
              "type": "object",
              "required": ["observer", "state_changed", "evidence"],
              "properties": {
                "observer": { "type": "string", "minLength": 1 },
                "observed_at": { "type": "string" },
                "state_changed": { "$ref": "#/definitions/tri_state_bool" },
                "before_state_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "after_state_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "observed_mutations": {
                  "type": "array",
                  "items": { "type": "object" }
                },
                "evidence": { "$ref": "#/definitions/evidence_metadata" }
              },
              "additionalProperties": true
            },
            "mutation_manifest": {
              "type": "array",
              "items": { "type": "object" }
            }
          },
          "additionalProperties": true
        },
        "agent_claim": {
          "type": "object",
          "required": ["claimed_side_effect", "evidence"],
          "properties": {
            "claimed_action": { "type": "string" },
            "claimed_side_effect": { "type": "string" },
            "evidence": { "$ref": "#/definitions/evidence_metadata" }
          },
          "additionalProperties": true
        },
        "evidence_completeness": {
          "type": "object",
          "required": [
            "complete",
            "missing"
          ],
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "missing": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  }
}
