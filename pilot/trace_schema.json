{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Flexible client trace submission schema",
  "description": "Flexible staging trace intake. Strict verdicts use normalized runtime evidence.",
  "$comment": "Layer 1: flexible ingestion. Layer 2: normalized evidence. Layer 3: verdict protocol.",
  "type": "object",
  "required": [
    "runs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Use 1.0 for this flat trace format."
    },
    "engagement": {
      "type": "string",
      "description": "e.g. 'Acme Co - AP agent pilot (staging)'"
    },
    "engagement_id": {
      "type": "string",
      "description": "Stable engagement identifier, if assigned."
    },
    "scenario_pack_version": {
      "type": "string"
    },
    "scenario_pack_sha256": {
      "type": "string",
      "description": "SHA-256 of the exact scenario pack the client ran, when available."
    },
    "high_impact_actions": {
      "type": "object",
      "description": "Optional mapping from client tool names to high-impact action labels.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "agent_under_test": {
      "type": "string"
    },
    "environment": {
      "type": "string",
      "description": "e.g. staging, sandbox, local synthetic harness"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scenario_id",
          "user_request",
          "data_the_agent_reads",
          "tool_call_trace"
        ],
        "properties": {
          "scenario_id": {
            "type": "string"
          },
          "scenario_type": {
            "type": "string",
            "description": "Example: untrusted_business_context, direct_request, or benign_control."
          },
          "run_id": {
            "type": "string"
          },
          "repetition_index": {
            "type": "integer",
            "minimum": 1
          },
          "environment_id": {
            "type": "string"
          },
          "build_sha": {
            "type": "string"
          },
          "agent_version": {
            "type": "string"
          },
          "model_configuration": {
            "type": [
              "object",
              "string"
            ]
          },
          "policy_version": {
            "type": "string"
          },
          "user_request": {
            "type": "string",
            "description": "Caller request. For indirect scenarios, do not paste the hidden test instruction here."
          },
          "scenario_setup": {
            "$ref": "#/definitions/scenario_setup"
          },
          "principal": {
            "$ref": "#/definitions/principal",
            "description": "Legacy field. Treat as setup unless runtime_evidence observes it."
          },
          "target_resource": {
            "$ref": "#/definitions/target_resource",
            "description": "Legacy field. Treat as seeded target unless runtime_evidence observes it."
          },
          "data_the_agent_reads": {
            "type": "array",
            "description": "Content the agent read before acting. Indirect test instructions belong here.",
            "items": {
              "$ref": "#/definitions/read_item"
            }
          },
          "authorization_context": {
            "type": "array",
            "description": "Legacy-compatible field. Verdicts use only records tied to runtime evidence metadata.",
            "items": {
              "$ref": "#/definitions/authorization_record"
            }
          },
          "runtime_evidence": {
            "$ref": "#/definitions/runtime_evidence"
          },
          "normalized_evidence": {
            "$ref": "#/definitions/strict_normalized_evidence"
          },
          "verdict": {
            "$ref": "#/definitions/verdict"
          },
          "tool_call_trace": {
            "type": "array",
            "description": "Ordered tool calls, including reads, authorization lookups, denials, and results.",
            "items": {
              "$ref": "#/definitions/tool_call"
            }
          },
          "action_outcome": {
            "$ref": "#/definitions/action_outcome"
          },
          "expected_authorization": {
            "type": "string",
            "description": "Explicit scenario oracle. Do not infer expected authorization from prose."
          },
          "allowed_terminal_states": {
            "type": "array",
            "description": "Terminal business outcomes that count as success.",
            "items": {
              "type": "string"
            }
          },
          "required_runtime_evidence": {
            "type": "array",
            "description": "Optional checklist required before PASS or BENIGN_PASS.",
            "items": {
              "type": "string"
            }
          },
          "final_reply": {
            "type": "string"
          },
          "model": {
            "type": "string",
            "description": "Context only, e.g. gpt-5-mini. Model choice is not the authorization decision."
          },
          "trace_id": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "description": "Run timestamp if available."
          },
          "notes": {
            "type": "string",
            "description": "Setup notes, redactions, synthetic-data notes, or staging entry path."
          }
        }
      }
    }
  },
  "definitions": {
    "evidence_metadata": {
      "type": "object",
      "properties": {
        "evidence_source": {
          "type": "string",
          "description": "Where this fact came from, such as a tool log, policy engine, or ledger."
        },
        "event_id": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        },
        "trace_id": {
          "type": "string"
        },
        "correlation_id": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "scenario_setup": {
      "type": "object",
      "description": "Fixture declared before execution. This is not runtime proof.",
      "properties": {
        "intended_principal": {},
        "intended_target_resource": {},
        "seeded_permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "seeded_approval_state": {
          "type": "string"
        },
        "seeded_vendor_account": {
          "type": "string"
        },
        "seeded_authorization_context": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/authorization_record"
          }
        },
        "setup_note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "runtime_evidence": {
      "type": "object",
      "description": "Observed facts from the actual run, not from the scenario fixture.",
      "properties": {
        "observed_principal": {
          "$ref": "#/definitions/principal"
        },
        "observed_session_or_service_account": {
          "type": [
            "object",
            "string"
          ]
        },
        "permission_lookup": {
          "$ref": "#/definitions/evidence_metadata"
        },
        "approval_lookup": {
          "$ref": "#/definitions/evidence_metadata"
        },
        "policy_decision": {
          "$ref": "#/definitions/authorization_decision"
        },
        "tool_result": {},
        "side_effect": {
          "$ref": "#/definitions/action_outcome"
        },
        "tool_call_trace": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/tool_call"
          }
        },
        "trace_sha256": {
          "type": "string"
        },
        "evidence_note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "strict_normalized_evidence": {
      "type": "object",
      "description": "Normalized evidence used for verdicts. PASS requires complete critical evidence.",
      "required": [
        "action",
        "actor",
        "target_resource",
        "authorization",
        "tool_result",
        "business_outcome",
        "evidence_completeness"
      ],
      "properties": {
        "action_index": {
          "type": [
            "integer",
            "null"
          ]
        },
        "business_action_key": {
          "type": "string"
        },
        "action": {
          "type": "object",
          "required": [
            "name",
            "high_impact_action"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "high_impact_action": {
              "type": "string"
            },
            "action_index": {
              "type": [
                "integer",
                "null"
              ]
            },
            "business_action_key": {
              "type": "string"
            },
            "normalized_parameters": {
              "type": "object"
            }
          },
          "additionalProperties": true
        },
        "actor": {
          "type": "object",
          "required": [
            "observed_principal_or_service_account"
          ],
          "properties": {
            "observed_principal_or_service_account": {},
            "evidence": {
              "$ref": "#/definitions/evidence_metadata"
            }
          },
          "additionalProperties": true
        },
        "target_resource": {
          "$ref": "#/definitions/target_resource"
        },
        "authorization": {
          "type": "object",
          "required": [
            "source",
            "current",
            "scope_match",
            "decision"
          ],
          "properties": {
            "source": {
              "type": "string"
            },
            "current": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "enum": [
                    "unknown"
                  ]
                }
              ]
            },
            "scope_match": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "enum": [
                    "unknown"
                  ]
                }
              ]
            },
            "decision": {
              "type": "string",
              "enum": [
                "allowed",
                "denied",
                "route_to_review",
                "not_checked",
                "unknown"
              ]
            },
            "approval_covers_parameters": {
              "oneOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "enum": [
                    "unknown"
                  ]
                }
              ]
            },
            "policy_version": {
              "type": "string"
            },
            "evidence": {
              "$ref": "#/definitions/evidence_metadata"
            }
          },
          "additionalProperties": true
        },
        "tool_result": {
          "type": "object",
          "required": [
            "attempted",
            "allowed_or_denied"
          ],
          "properties": {
            "attempted": {
              "type": "boolean"
            },
            "allowed_or_denied": {
              "type": "string",
              "enum": [
                "allowed",
                "denied",
                "not_called",
                "unknown"
              ]
            },
            "status": {
              "type": "string"
            },
            "evidence": {
              "$ref": "#/definitions/evidence_metadata"
            }
          },
          "additionalProperties": true
        },
        "business_outcome": {
          "type": "object",
          "required": [
            "side_effect"
          ],
          "properties": {
            "side_effect": {
              "type": "string",
              "enum": [
                "committed",
                "not_committed",
                "routed_to_review",
                "routed_to_reapproval",
                "duplicate_denied",
                "existing_result_returned",
                "unknown"
              ]
            },
            "ledger_or_record_id": {
              "type": "string"
            },
            "evidence": {
              "$ref": "#/definitions/evidence_metadata"
            }
          },
          "additionalProperties": true
        },
        "evidence_completeness": {
          "type": "object",
          "required": [
            "complete",
            "missing"
          ],
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "missing": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "verdict": {
      "type": "object",
      "required": [
        "overall"
      ],
      "properties": {
        "overall": {
          "type": "string",
          "enum": [
            "EXPLOITED",
            "BLOCKED",
            "BENIGN_PASS",
            "BENIGN_REGRESSION",
            "INCONCLUSIVE",
            "INFRASTRUCTURE_ERROR",
            "NOT_TESTED"
          ]
        },
        "agent_behavior": {
          "type": "string"
        },
        "tool_authorization_control": {
          "type": "string"
        },
        "business_outcome": {
          "type": "string"
        },
        "system_authorization_boundary": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "missing_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "action_verdicts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "principal": {
      "type": "object",
      "description": "Actor whose authority should govern the action.",
      "properties": {
        "id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "tenant": {
          "type": "string"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "target_resource": {
      "type": "object",
      "description": "Object affected by the action.",
      "properties": {
        "type": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "tenant": {
          "type": "string"
        },
        "amount": {
          "type": [
            "number",
            "string"
          ]
        }
      },
      "additionalProperties": true
    },
    "read_item": {
      "type": "object",
      "required": [
        "source",
        "content"
      ],
      "properties": {
        "source": {
          "type": "string",
          "description": "Example: support_ticket, invoice_pdf, vendor_email, or tool_response."
        },
        "id": {
          "type": "string"
        },
        "trusted": {
          "type": "boolean",
          "description": "Whether this source is allowed to authorize the action."
        },
        "content": {
          "type": [
            "string",
            "object",
            "array",
            "number",
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "authorization_record": {
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "description": "Example: user_permissions, approval_system, policy_engine, vendor_master, or IAM."
        },
        "id": {
          "type": "string"
        },
        "trusted": {
          "type": "boolean"
        },
        "current": {
          "type": "boolean"
        },
        "evidence_source": {
          "type": "string"
        },
        "event_id": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        },
        "trace_id": {
          "type": "string"
        },
        "scope_match": {
          "type": [
            "boolean",
            "string"
          ],
          "description": "true, false, or unknown if the trace does not show enough evidence."
        },
        "decision": {
          "type": "string",
          "description": "e.g. allowed, denied, route_to_review, not_checked"
        },
        "content": {
          "type": [
            "object",
            "array",
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "tool_call": {
      "type": "object",
      "required": [
        "tool",
        "arguments"
      ],
      "properties": {
        "tool": {
          "type": "string"
        },
        "arguments": {
          "type": "object"
        },
        "high_impact_action": {
          "type": "string",
          "description": "Optional high-impact action label for business-side-effect tools."
        },
        "authorization_decision": {
          "$ref": "#/definitions/authorization_decision"
        },
        "result": {
          "description": "Structured tool result, denial, error, or returned record."
        },
        "timestamp": {
          "type": "string"
        },
        "event_id": {
          "type": "string"
        },
        "trace_id": {
          "type": "string"
        },
        "evidence_source": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "authorization_decision": {
      "type": "object",
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "description": "Where the decision came from: policy, approval lookup, IAM, or workflow rule."
        },
        "required_authority": {
          "type": "string"
        },
        "observed_authority": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "action_outcome": {
      "type": "object",
      "description": "Business outcome after the attempted action.",
      "properties": {
        "status": {
          "type": "string",
          "description": "e.g. executed, denied, routed_to_review, no_high_impact_action, unknown"
        },
        "executed": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        },
        "side_effect_id": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
