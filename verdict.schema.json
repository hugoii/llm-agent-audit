{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actionboundary.dev/schemas/verdict.schema.json",
  "title": "ActionBoundary verdict schema",
  "description": "Scored output from python -m actionboundary score.",
  "type": "object",
  "required": ["schema_version", "contract_set_version", "counts", "scenario_coverage", "runs"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "pilot-verdict-1.3"
    },
    "contract_set_version": {
      "type": "string",
      "const": "actionboundary-contract-set-1.1"
    },
    "engagement_id": { "type": "string" },
    "scenario_pack_version": { "type": "string" },
    "policy_version": {
      "type": "string",
      "const": "pilot-verdict-1.3"
    },
    "scenario_pack_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "trace_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance": {
      "type": "object",
      "required": [
        "policy_version",
        "trace_sha256",
        "hash_algorithm",
        "trace_canonicalization"
      ],
      "properties": {
        "policy_version": {
          "type": "string",
          "const": "pilot-verdict-1.3"
        },
        "trace_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scenario_pack_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "hash_algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "trace_canonicalization": {
          "type": "string",
          "const": "json-canonical-v1-strip-trace-sha256"
        },
        "scenario_pack_canonicalization": {
          "type": "string",
          "const": "json-canonical-v1"
        }
      },
      "additionalProperties": true
    },
    "counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "scenario_coverage": {
      "type": "object",
      "required": ["complete", "total_scenarios", "tested_scenarios", "untested_scenario_ids"],
      "properties": {
        "complete": { "type": "boolean" },
        "total_scenarios": { "type": "integer", "minimum": 0 },
        "tested_scenarios": { "type": "integer", "minimum": 0 },
        "untested_scenario_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scenario_id", "verdict"],
        "properties": {
          "scenario_id": { "type": "string" },
          "verdict": {
            "type": "object",
            "required": ["overall", "reason", "missing_evidence"],
            "properties": {
              "overall": {
                "type": "string",
                "enum": [
                  "EXPLOITED",
                  "BLOCKED",
                  "BENIGN_PASS",
                  "BENIGN_REGRESSION",
                  "INCONCLUSIVE",
                  "INFRASTRUCTURE_ERROR",
                  "NOT_TESTED"
                ]
              },
              "reason": { "type": "string" },
              "system_authorization_boundary": { "type": "string" },
              "tool_authorization_control": { "type": "string" },
              "business_outcome": { "type": "string" },
              "agent_behavior": { "type": "string" },
              "missing_evidence": {
                "type": "array",
                "items": { "type": "string" }
              },
              "evidence_conflicts": {
                "type": "array",
                "items": { "type": "string" }
              },
              "action_verdicts": {
                "type": "array",
                "items": { "type": "object" }
              },
              "control_evidence": {
                "type": "object",
                "description": "Summary of provenance, approval binding, execution revalidation, and postcondition evidence."
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
